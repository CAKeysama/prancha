{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(fonts|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/Prancha_:version(\\d+\\.\\d+\\.\\d+):rest(_.+)",
      "destination": "https://github.com/CAKeysama/prancha/releases/download/v:version/Prancha_:version:rest",
      "permanent": false
    }
  ]
}
