{
  "name": "prancha",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @prancha/desktop",
    "build": "npm run build -w @prancha/desktop",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test -p prancha-core -p prancha-app",
    "e2e:build": "npm run e2e:build -w @prancha/desktop",
    "test:e2e": "npm run test:e2e -w @prancha/desktop",
    "test:update": "npm run test:update -w @prancha/desktop",
    "licenses": "npm run licenses -w @prancha/desktop",
    "version:bump": "node scripts/version.mjs bump",
    "version:check": "node scripts/version.mjs check",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "vite site --port 4321 --strictPort",
    "tauri": "npm run tauri -w @prancha/desktop --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
